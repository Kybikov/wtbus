# Production Compose configuration. Copy this to .env.production on the server;
# do not commit the filled file and do not reuse any local development password.
VIVAT_DOMAIN=crm.example.com

POSTGRES_DB=vivat
POSTGRES_USER=vivat
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Use URL-safe characters (for example, a base64url secret without `:` or `@`).
# Redis is private to Docker but still requires a password in production.
REDIS_PASSWORD=replace-with-a-long-random-url-safe-password

BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-unique-12-plus-character-password
BOOTSTRAP_TENANT_SLUG=vivat-bus
# Keep false. Set true only for one controlled password-recovery deployment, then set it back to false.
BOOTSTRAP_OWNER_RESET_PASSWORD=false

# Required: protects the private SaaS control API.
SAAS_CONTROL_SECRET=replace-with-a-long-random-secret

# Optional: enable the Telegram bot profile after supplying a bot secret.
TELEGRAM_BOT_TOKEN=
BOT_TENANT_SLUG=vivat-bus
# For multiple company bots, use a private JSON array of {"token","tenantSlug"}.
TELEGRAM_BOTS_JSON=

# Web Push uses persistent VAPID keys stored in PostgreSQL (no acquiring API required).
PUSH_VAPID_SUBJECT=mailto:support@wtmelon.store
WS_ALLOWED_ORIGINS=https://vivat.wtmelon.store
