    "rules": [ { "name": "The Search-and-Signal Rule", "body": "The search rail may use a full gold surface; result and checkout cards remain neutral, with gold identifying action and meaningful values.", "section": "colors" }, { "name": "The Numbers-Align Rule", "body": "Keep trip times, prices, passenger quantities, and progress counts tabular. The selectable booking reference uses the existing mono face for identification, not display typography.", "section": "typography" } ],
    "dos": ["Do keep route, time, date range, timezone, and payment context readable as text.", "Do preserve visible facets above results and the stacked checkout summary on small screens.", "Do keep task actions and search fields at their established 44px height.", "Do respect reduced motion: result entry is motion-safe."],
