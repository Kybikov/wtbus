# Local Docker configuration. Copy this file to .env before a shared/server deployment.
REACTBITS_LICENSE_KEY=

POSTGRES_DB=vivat
POSTGRES_USER=vivat
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
WEB_PORT=3001

# Bootstrap account for the first company owner.
BOOTSTRAP_OWNER_EMAIL=admin@example.com
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_TENANT_SLUG=vivat-bus
# Set true for one restart only to reset the existing bootstrap owner's password and revoke its sessions.
BOOTSTRAP_OWNER_RESET_PASSWORD=false
SESSION_COOKIE_SECURE=false

# Optional integrations.
# Legacy single-bot mode. It is also the simplest local configuration.
TELEGRAM_BOT_TOKEN=
BOT_TENANT_SLUG=vivat-bus
# Multi-tenant bot mode: JSON array, e.g. [{"token":"...","tenantSlug":"another-company"}].
# Keep real tokens only in your private .env / secrets manager, never in Git.
TELEGRAM_BOTS_JSON=
SAAS_CONTROL_SECRET=

# Web Push keys are generated once and stored in PostgreSQL automatically.
# Back up the database to retain subscriptions across deployments.
PUSH_VAPID_SUBJECT=mailto:support@wtmelon.store
